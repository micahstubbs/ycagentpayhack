# Mock .env file for deployment
# Copy this to .env and fill in your actual values

# ============================================
# Base/Blockchain Configuration
# ============================================

# Your private key from MetaMask (starts with 0x)
# SECURITY: Never commit this to git! Only use test wallets!
PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Base Sepolia RPC URL (public endpoint)
BASE_RPC_URL=https://sepolia.base.org

# Contract addresses (fill these in after deployment)
INVOICE_NFT_ADDRESS=
LOAN_ESCROW_ADDRESS=

# Optional: BaseScan API key for contract verification
# Get from: https://basescan.org/myapikey
BASESCAN_API_KEY=

# ============================================
# Stripe Configuration (for later tasks)
# ============================================

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_ACCOUNT_ID=acct_...

# ============================================
# Anthropic Configuration (for later tasks)
# ============================================

ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# Locus Configuration (for later tasks)
# ============================================

LOCUS_API_KEY=...
LOCUS_API_URL=https://api.uselocus.com

# ============================================
# Server Configuration (for later tasks)
# ============================================

PORT=3000
WEBHOOK_URL=https://your-app.replit.dev/webhook
